server {
    listen 127.0.0.1:80;
    listen <private-network-address>:80;
    # The public proxy (edge host) forwards tanks.example.com to this host
    server_name tanks.example.com;
    absolute_redirect off;

    access_log /var/log/nginx/tanks.access.log;
    error_log  /var/log/nginx/tanks.error.log;

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
